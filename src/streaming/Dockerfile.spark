# Spark 3.5 + PySpark con pandas/pyarrow (applyInPandasWithState) y conector de GCS.
# Los conectores de Kafka y BigQuery se resuelven con --packages al arrancar (caché en volumen).
FROM apache/spark:3.5.3-scala2.12-java17-python3-ubuntu

USER root
RUN pip install --no-cache-dir pandas==2.2.3 pyarrow==17.0.0
ADD --chmod=644 https://repo1.maven.org/maven2/com/google/cloud/bigdataoss/gcs-connector/hadoop3-2.2.22/gcs-connector-hadoop3-2.2.22-shaded.jar /opt/spark/jars/

WORKDIR /app
COPY streaming_job.py /app/
