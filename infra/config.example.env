# Configuración común de la infraestructura Lumina (DataEnergía).
# Plantilla versionada: cópiala a infra/config.env (ignorado por git) y completa los IDs.
# Todos los scripts de infra/ hacen `source infra/config.env`.
# No se modifica la configuración global de gcloud: cada comando pasa --project.

PROJECT_ID="${PROJECT_ID:-CAMBIAR_ID_DEL_PROYECTO}"
BILLING_ACCOUNT="${BILLING_ACCOUNT:-CAMBIAR_XXXXXX-XXXXXX-XXXXXX}"

REGION="us-central1"
ZONE="us-central1-a"

# GCS: data lake (bronze / silver-gold). Los nombres de bucket son globales.
BUCKET_RAW="${PROJECT_ID}-lumina-raw"
BUCKET_CURATED="${PROJECT_ID}-lumina-curated"

# BigQuery: multi-región US para poder cruzar con bigquery-public-data (NOAA GSOD vive en US).
# Un dataset en la multi-región US puede cargar Parquet desde un bucket en us-central1.
BQ_LOCATION="US"
BQ_DATASETS="lumina_curated lumina_rt lumina_ml lumina_olap lumina_muestra"

# Presupuesto
BUDGET_NAME="lumina-presupuesto-300usd"
# Moneda de la cuenta de facturación (esta cuenta está en PEN). US$300 ≈ S/1,125 a ~3.75 PEN/USD.
BUDGET_AMOUNT="1125PEN"

# VMs
INGEST_VM="lumina-ingest"
OPS_VM="lumina-ops"

# Token de Kaggle: va SOLO en config.env (ignorado por git); 03_secreto_kaggle.sh lo sube a Secret Manager
KAGGLE_API_TOKEN=""
# Nombre del secreto en Secret Manager
KAGGLE_SECRET="kaggle-api-token"

LABELS="proyecto=lumina,curso=bigdata-utec"
