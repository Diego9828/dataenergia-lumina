flowchart LR
  subgraph SRC["Fuentes"]
    F1["Medidores inteligentes<br/>8 M, cada 30 min"]
    F2["Operador de red<br/>demanda nacional y renovables"]
    F3["Eventos de tarifa<br/>dinámica (DR)"]
    F4["Clima<br/>pronóstico y observado"]
    F5["Maestros<br/>hogares, Acorn, feriados"]
  end

  subgraph ING["Capa de Ingesta"]
    I1["Managed Service for<br/>Apache Kafka<br/>tópicos por dominio"]
    I2["Cargas batch<br/>Kafka Connect / Storage Transfer"]
  end

  subgraph COMP["Capa de Cómputo"]
    C1["Spark Structured Streaming<br/>picos, anomalías, huecos, DR"]
    C2["Spark batch serverless<br/>limpieza, modelo, perfiles"]
    C3["BigQuery SQL / BQML<br/>pronóstico D+1, PdM"]
  end

  subgraph ALM["Capa de Almacenamiento"]
    A1[("Lakehouse GCS<br/>raw / silver / gold<br/>Parquet, dual-region")]
    A2[("BigQuery curated<br/>capa batch: historia,<br/>perfiles, umbrales")]
    A4[("BigQuery rt<br/>capa de velocidad:<br/>alertas, carga de hoy")]
    A3[("Bigtable<br/>serie de tiempo<br/>por medidor")]
  end

  subgraph EXP["Capa de Exposición"]
    E0["Vistas lumina_olap<br/>historia batch + hoy rt"]
    E1["API REST / WebSocket<br/>Cloud Run"]
    E2["Looker Studio<br/>informes OLAP"]
    E3["Alertas DR<br/>tópico alerts.dr"]
  end

  subgraph TRV["Transversal"]
    T1{{"Airflow<br/>orquestación"}}
    T2{{"IAM, Secret Manager<br/>policy tags"}}
    T3{{"Cloud Monitoring<br/>y Logging"}}
  end

  APP["App móvil y<br/>Front-End Lumina"]

  F1 --> I1
  F2 --> I1
  F3 --> I1
  F4 --> I2
  F5 --> I2
  I1 --> C1
  I1 -->|1 · sink raw| A1
  I2 --> C2
  C2 -->|silver / gold| A1
  C2 -->|carga| A2
  C1 --> A3
  C1 --> A4
  C1 --> E3
  C3 -->|pronósticos| A2
  A2 -.->|2 · perfiles y umbrales| C1
  A2 -->|3 · unión| E0
  A4 -->|3 · unión| E0
  A2 -.->|4 · reconciliación| A4
  E0 --> E2
  E0 --> E1
  A3 --> E1
  E1 --> APP
  E3 --> APP
  T1 -.-> C2
  T1 -.-> C3

  classDef src fill:#E8F1FB,stroke:#3B7DD8,color:#10243F
